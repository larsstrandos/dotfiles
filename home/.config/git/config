# Name/email are machine-local and not committed: ~/.config/git/identity
#   git config --file ~/.config/git/identity user.name  "..."
#   git config --file ~/.config/git/identity user.email "..."
[include]
	path = ~/.config/git/identity
[init]
	defaultBranch = main
[gpg]
	format = ssh
[gpg "ssh"]
	program = /opt/1Password/op-ssh-sign
[user]
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIH8rIBMXZoFRTGgO3p86PUs/MQgNVUqMtEbFtRxnLICp id_ed25519 - Privat
